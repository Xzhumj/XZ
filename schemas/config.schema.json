{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/video-auto-template/config.schema.json",
  "title": "Video Auto Template local configuration",
  "type": "object",
  "required": [
    "schemaVersion",
    "toolkitRoot"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "toolkitRoot": {
      "type": "string",
      "minLength": 1
    },
    "catalogPath": {
      "type": [
        "string",
        "null"
      ]
    },
    "ffmpegPath": {
      "type": [
        "string",
        "null"
      ]
    },
    "configuredAt": {
      "type": "string"
    },
    "lastDoctorAt": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
